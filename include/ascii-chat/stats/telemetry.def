/* Canonical metric identity and producer for each typed process stat. */
ASCII_STATS_COUNTER(FRAMES_ENQUEUED, STATS_COUNTER_FRAMES_ENQUEUED, "ascii-chat.frames.enqueued", "{frame}")
ASCII_STATS_COUNTER(QUEUE_DROPS, STATS_COUNTER_QUEUE_DROPS, "ascii-chat.queue.frames.dropped", "{frame}")
ASCII_STATS_COUNTER(MIGRATION_FAILURES, STATS_COUNTER_MIGRATION_FAILURES, "ascii-chat.discovery.migrations.failed", "{event}")
ASCII_STATS_COUNTER(RECONNECTS, RECONNECT, "ascii-chat.network.reconnects", "{attempt}")
ASCII_STATS_COUNTER(RECORDING_FRAMES, FRAME_ENCODED, "ascii-chat.recording.frames.encoded", "{frame}")
ASCII_STATS_COUNTER(FRAMES_SENT, STATS_COUNTER_FRAMES_SENT, "ascii-chat.frames.sent", "{frame}")
ASCII_STATS_COUNTER(FRAMES_RECEIVED, STATS_COUNTER_FRAMES_RECEIVED, "ascii-chat.frames.received", "{frame}")
ASCII_STATS_COUNTER(FRAMES_CAPTURED, FRAME_CAPTURED, "ascii-chat.frames.captured", "{frame}")
ASCII_STATS_COUNTER(FRAMES_CONVERTED, STATS_COUNTER_FRAMES_CONVERTED, "ascii-chat.frames.converted", "{frame}")
ASCII_STATS_COUNTER(FRAMES_ENCODED, STATS_COUNTER_FRAMES_ENCODED, "ascii-chat.video.encode.frames", "{frame}")
ASCII_STATS_COUNTER(FRAMES_DECODED, STATS_COUNTER_FRAMES_DECODED, "ascii-chat.frames.decoded", "{frame}")
ASCII_STATS_COUNTER(FRAMES_PRESENTED, STATS_COUNTER_FRAMES_PRESENTED, "ascii-chat.frames.presented", "{frame}")
ASCII_STATS_COUNTER(FRAMES_SKIPPED, STATS_COUNTER_FRAMES_SKIPPED, "ascii-chat.frames.skipped", "{frame}")
ASCII_STATS_COUNTER(FRAMES_DROPPED, STATS_COUNTER_FRAMES_DROPPED, "ascii-chat.frames.dropped.total", "{frame}")
ASCII_STATS_COUNTER(PACKETS_SENT, STATS_COUNTER_PACKETS_SENT, "ascii-chat.network.packets.sent", "{packet}")
ASCII_STATS_COUNTER(PACKETS_RECEIVED, STATS_COUNTER_PACKETS_RECEIVED, "ascii-chat.network.packets.received", "{packet}")
ASCII_STATS_COUNTER(BYTES_SENT, NET_TX, "ascii-chat.network.sent", "By")
ASCII_STATS_COUNTER(BYTES_RECEIVED, NET_RX, "ascii-chat.network.received", "By")
ASCII_STATS_COUNTER(SEND_ERRORS, NET_TX_ERRORS, "ascii-chat.network.send.errors", "{error}")
ASCII_STATS_COUNTER(RECEIVE_ERRORS, NET_RX_ERRORS, "ascii-chat.network.receive.errors", "{error}")
ASCII_STATS_COUNTER(AUDIO_UNDERRUNS, STATS_COUNTER_AUDIO_UNDERRUNS, "ascii-chat.audio.device.underruns", "{event}")
ASCII_STATS_COUNTER(AUDIO_OVERRUNS, STATS_COUNTER_AUDIO_OVERRUNS, "ascii-chat.audio.device.overruns", "{event}")
ASCII_STATS_COUNTER(SESSION_CREATES, STATS_COUNTER_SESSION_CREATES, "ascii-chat.discovery.sessions.created", "{session}")
ASCII_STATS_COUNTER(SESSION_JOINS, STATS_COUNTER_SESSION_JOINS, "ascii-chat.discovery.sessions.joined", "{join}")
ASCII_STATS_COUNTER(SESSION_LOOKUPS, STATS_COUNTER_SESSION_LOOKUPS, "ascii-chat.discovery.sessions.looked_up", "{request}")
ASCII_STATS_COUNTER(REQUEST_FAILURES, STATS_COUNTER_REQUEST_FAILURES, "ascii-chat.discovery.requests.failed", "{request}")
ASCII_STATS_COUNTER(RATE_LIMIT_REJECTIONS, RATE_REJECT, "ascii-chat.network.rate_limit.rejections", "{request}")
ASCII_STATS_COUNTER(SESSION_EXPIRATIONS, STATS_COUNTER_SESSION_EXPIRATIONS, "ascii-chat.discovery.sessions.expired", "{session}")
ASCII_STATS_COUNTER(HOST_MIGRATIONS, STATS_COUNTER_HOST_MIGRATIONS, "ascii-chat.discovery.migrations.completed", "{event}")
ASCII_STATS_GAUGE(CONNECTIONS_ACTIVE, CONNECTIONS, "ascii-chat.network.connections.active", "{connection}")
ASCII_STATS_GAUGE(SESSIONS_ACTIVE, SESSIONS, "ascii-chat.discovery.sessions.active", "{session}")
ASCII_STATS_GAUGE(PARTICIPANTS_ACTIVE, PARTICIPANTS, "ascii-chat.discovery.participants.active", "{participant}")
ASCII_STATS_GAUGE(VIDEO_QUEUE_DEPTH, STATS_GAUGE_VIDEO_QUEUE_DEPTH, "ascii-chat.network.video.queue.depth", "{frame}")
ASCII_STATS_GAUGE(AUDIO_BUFFERED_SAMPLES, STATS_GAUGE_AUDIO_BUFFERED_SAMPLES, "ascii-chat.audio.device.buffered_samples", "{sample}")
ASCII_STATS_DURATION(RECORDING, STATS_DURATION_RECORDING, "ascii-chat.recording.frame.duration", "s")
ASCII_STATS_DURATION(CAPTURE, STATS_DURATION_CAPTURE, "ascii-chat.media.capture.duration", "s")
ASCII_STATS_DURATION(ASCII_CONVERT, STATS_DURATION_ASCII_CONVERT, "ascii-chat.video.ascii.convert.duration", "s")
ASCII_STATS_DURATION(ENCODE, STATS_DURATION_ENCODE, "ascii-chat.video.encode.duration", "s")
ASCII_STATS_DURATION(DECODE, STATS_DURATION_DECODE, "ascii-chat.video.decode.duration", "s")
ASCII_STATS_DURATION(AUDIO_MIX, STATS_DURATION_AUDIO_MIX, "ascii-chat.audio.mix.duration", "s")
ASCII_STATS_DURATION(TERMINAL_WRITE, STATS_DURATION_TERMINAL_WRITE, "ascii-chat.terminal.frame.write.duration", "s")
ASCII_STATS_DURATION(CONNECTION_SETUP, STATS_DURATION_CONNECTION_SETUP, "ascii-chat.network.connection.setup.duration", "s")
ASCII_STATS_DURATION(REQUEST, STATS_DURATION_REQUEST, "ascii-chat.discovery.request.duration", "s")
ASCII_STATS_DURATION(RTT, RTT, "ascii-chat.network.round_trip_time", "s")
