/* One finite metric for each typed process stat; peer scopes are excluded. */
ASCII_STATS_COUNTER(FRAMES_ENQUEUED, "frames_enqueued", "{frame}")
ASCII_STATS_COUNTER(QUEUE_DROPS, "queue_drops", "{frame}")
ASCII_STATS_COUNTER(MIGRATION_FAILURES, "migration_failures", "{event}")
ASCII_STATS_COUNTER(RECONNECTS, "reconnects", "{attempt}")
ASCII_STATS_COUNTER(RECORDING_FRAMES, "recording_frames", "{frame}")
ASCII_STATS_COUNTER(FRAMES_SENT, "frames_sent", "{frame}")
ASCII_STATS_COUNTER(FRAMES_RECEIVED, "frames_received", "{frame}")
ASCII_STATS_COUNTER(FRAMES_CAPTURED, "frames_captured", "{frame}")
ASCII_STATS_COUNTER(FRAMES_CONVERTED, "frames_converted", "{frame}")
ASCII_STATS_COUNTER(FRAMES_ENCODED, "frames_encoded", "{frame}")
ASCII_STATS_COUNTER(FRAMES_DECODED, "frames_decoded", "{frame}")
ASCII_STATS_COUNTER(FRAMES_PRESENTED, "frames_presented", "{frame}")
ASCII_STATS_COUNTER(FRAMES_SKIPPED, "frames_skipped", "{frame}")
ASCII_STATS_COUNTER(FRAMES_DROPPED, "frames_dropped", "{frame}")
ASCII_STATS_COUNTER(PACKETS_SENT, "packets_sent", "{packet}")
ASCII_STATS_COUNTER(PACKETS_RECEIVED, "packets_received", "{packet}")
ASCII_STATS_COUNTER(BYTES_SENT, "bytes_sent", "By")
ASCII_STATS_COUNTER(BYTES_RECEIVED, "bytes_received", "By")
ASCII_STATS_COUNTER(SEND_ERRORS, "send_errors", "{error}")
ASCII_STATS_COUNTER(RECEIVE_ERRORS, "receive_errors", "{error}")
ASCII_STATS_COUNTER(AUDIO_UNDERRUNS, "audio_underruns", "{event}")
ASCII_STATS_COUNTER(AUDIO_OVERRUNS, "audio_overruns", "{event}")
ASCII_STATS_COUNTER(SESSION_CREATES, "session_creates", "{session}")
ASCII_STATS_COUNTER(SESSION_JOINS, "session_joins", "{join}")
ASCII_STATS_COUNTER(SESSION_LOOKUPS, "session_lookups", "{request}")
ASCII_STATS_COUNTER(REQUEST_FAILURES, "request_failures", "{request}")
ASCII_STATS_COUNTER(RATE_LIMIT_REJECTIONS, "rate_limit_rejections", "{request}")
ASCII_STATS_COUNTER(SESSION_EXPIRATIONS, "session_expirations", "{session}")
ASCII_STATS_COUNTER(HOST_MIGRATIONS, "host_migrations", "{event}")
ASCII_STATS_GAUGE(CONNECTIONS_ACTIVE, "connections_active", "{connection}")
ASCII_STATS_GAUGE(SESSIONS_ACTIVE, "sessions_active", "{session}")
ASCII_STATS_GAUGE(PARTICIPANTS_ACTIVE, "participants_active", "{participant}")
ASCII_STATS_GAUGE(VIDEO_QUEUE_DEPTH, "video_queue_depth", "{frame}")
ASCII_STATS_GAUGE(AUDIO_BUFFERED_SAMPLES, "audio_buffered_samples", "{sample}")
ASCII_STATS_DURATION(RECORDING, "recording", "s")
ASCII_STATS_DURATION(CAPTURE, "capture", "s")
ASCII_STATS_DURATION(ASCII_CONVERT, "ascii_convert", "s")
ASCII_STATS_DURATION(ENCODE, "encode", "s")
ASCII_STATS_DURATION(DECODE, "decode", "s")
ASCII_STATS_DURATION(AUDIO_MIX, "audio_mix", "s")
ASCII_STATS_DURATION(TERMINAL_WRITE, "terminal_write", "s")
ASCII_STATS_DURATION(CONNECTION_SETUP, "connection_setup", "s")
ASCII_STATS_DURATION(REQUEST, "request", "s")
ASCII_STATS_DURATION(RTT, "rtt", "s")
