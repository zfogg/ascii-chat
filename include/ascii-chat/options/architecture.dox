/**
 * @file architecture.dox
 * @brief ascii-chat option architecture.
 *
 * ascii-chat owns the application registry, mode-specific defaults, dependency
 * policy, and the final option lifecycle. libflags owns the reusable option
 * schema, parsing, environment mapping, TOML/JSON conversion, completions,
 * manpage generation, and command diagnostics.
 *
 * The application builds a libflags schema from its registry:
 *
 * @code
 * flags_schema_builder_t *builder = flags_schema_builder_create();
 * options_registry_add_all_to_flags_builder(builder, OPTION_MODE_ALL);
 * const flags_schema_t *schema = flags_schema_builder_schema(builder);
 * flags_context_t *context = flags_create(schema, &options, sizeof(options));
 * @endcode
 *
 * ascii-chat then installs its logging callback, path policy, mode commands,
 * and application validation around that reusable context. Command-line and
 * configuration values are applied through libflags; application code handles
 * only behavior that depends on ascii-chat modes or subsystems.
 *
 * @ingroup options
 */
