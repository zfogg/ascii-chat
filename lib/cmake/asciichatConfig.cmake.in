include(CMakeFindDependencyMacro)
find_dependency(ascii-chat CONFIG COMPONENTS ${asciichat_FIND_COMPONENTS}
    PATHS "${CMAKE_CURRENT_LIST_DIR}/../ascii-chat" NO_DEFAULT_PATH)
set(asciichat_FOUND "${ascii-chat_FOUND}")
set(asciichat_VERSION "${ascii-chat_VERSION}")
set(asciichat_MSVC_RUNTIME_LIBRARY "${ascii-chat_MSVC_RUNTIME_LIBRARY}")
set(asciichat_INCLUDE_DIRS "${ascii-chat_INCLUDE_DIRS}")
foreach(_variant shared static)
    set(asciichat_${_variant}_FOUND "${ascii-chat_${_variant}_FOUND}")
endforeach()
check_required_components(asciichat)
