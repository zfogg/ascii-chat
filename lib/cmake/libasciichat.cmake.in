@PACKAGE_INIT@

# Both package spellings expose the same imported targets. Components let a
# shared-only consumer avoid resolving the static library's link dependencies.
include(CMakeFindDependencyMacro)
set(_asciichat_prefix "${PACKAGE_PREFIX_DIR}")
set(_asciichat_include "${_asciichat_prefix}/include;${_asciichat_prefix}/include/ascii-chat")
set(_asciichat_archive "${_asciichat_prefix}/lib/libasciichat.a")
if(WIN32)
    set(_asciichat_shared "${_asciichat_prefix}/bin/asciichat.dll")
    set(_asciichat_implib "${_asciichat_prefix}/lib/asciichat.lib")
else()
    set(_asciichat_shared "${_asciichat_prefix}/lib/libasciichat@CMAKE_SHARED_LIBRARY_SUFFIX@")
endif()

set(ascii-chat_VERSION "@ASCIICHAT_LIB_VERSION@")
set(ascii-chat_PROJECT_VERSION "@PROJECT_VERSION@")
set(ascii-chat_MSVC_RUNTIME_LIBRARY "@CMAKE_MSVC_RUNTIME_LIBRARY@")
set(ascii-chat_INCLUDE_DIRS "${_asciichat_include}")
set(ascii-chat_FOUND TRUE)
set(ascii-chat_static_FOUND FALSE)
set(ascii-chat_shared_FOUND FALSE)
if(EXISTS "${_asciichat_archive}")
    set(ascii-chat_static_FOUND TRUE)
endif()
if(EXISTS "${_asciichat_shared}" AND (NOT WIN32 OR EXISTS "${_asciichat_implib}"))
    set(ascii-chat_shared_FOUND TRUE)
endif()
set(_asciichat_components "${ascii-chat_FIND_COMPONENTS}")
if(NOT _asciichat_components)
    foreach(_variant shared static)
        if(ascii-chat_${_variant}_FOUND)
            list(APPEND _asciichat_components "${_variant}")
        endif()
    endforeach()
endif()
if(NOT _asciichat_components)
    set(ascii-chat_FOUND FALSE)
    set(ascii-chat_NOT_FOUND_MESSAGE "No ascii-chat library artifacts were installed. Build static-lib and/or shared-lib before installing Development.")
    return()
endif()
check_required_components(ascii-chat)
if(NOT ascii-chat_FOUND)
    set(ascii-chat_NOT_FOUND_MESSAGE "A requested ascii-chat library component is not installed: ${ascii-chat_FIND_COMPONENTS}")
    return()
endif()

if("shared" IN_LIST _asciichat_components AND ascii-chat_shared_FOUND AND NOT TARGET ascii-chat::shared)
    add_library(ascii-chat::shared SHARED IMPORTED)
    set_target_properties(ascii-chat::shared PROPERTIES
        IMPORTED_LOCATION "${_asciichat_shared}"
        INTERFACE_INCLUDE_DIRECTORIES "${_asciichat_include}")
    if(WIN32)
        set_property(TARGET ascii-chat::shared PROPERTY IMPORTED_IMPLIB "${_asciichat_implib}")
    endif()
endif()

if("static" IN_LIST _asciichat_components AND ascii-chat_static_FOUND AND NOT TARGET ascii-chat::static)
    find_dependency(PkgConfig)
    find_dependency(OpenSSL)
    find_dependency(Freetype)
    find_dependency(ZLIB)
    set(_asciichat_deps OpenSSL::SSL OpenSSL::Crypto Freetype::Freetype ZLIB::ZLIB)
    foreach(_module libsodium libzstd portaudio-2.0 opus libpcre2-8 sqlite3 libwebsockets libuv
            libavformat libavcodec libavutil libswscale libswresample miniupnpc)
        string(MAKE_C_IDENTIFIER "${_module}" _id)
        pkg_check_modules(_asciichat_${_id} REQUIRED IMPORTED_TARGET "${_module}")
        list(APPEND _asciichat_deps PkgConfig::_asciichat_${_id})
    endforeach()
    if(WIN32)
        # vcpkg's FFTW pkg-config file includes Unix -lm; its CMake target
        # supplies the actual Windows runtime dependencies.
        find_dependency(FFTW3 CONFIG)
        list(APPEND _asciichat_deps FFTW3::fftw3)
    else()
        pkg_check_modules(_asciichat_fftw REQUIRED IMPORTED_TARGET fftw3)
        list(APPEND _asciichat_deps PkgConfig::_asciichat_fftw)
        pkg_check_modules(_asciichat_fontconfig REQUIRED IMPORTED_TARGET fontconfig)
        list(APPEND _asciichat_deps PkgConfig::_asciichat_fontconfig)
    endif()
    foreach(_module vterm utf8proc)
        set(_bundled_names "${_module}")
        if(_module STREQUAL vterm)
            list(PREPEND _bundled_names asciichat-vterm)
        endif()
        find_library(_asciichat_bundled_${_module} NAMES ${_bundled_names}
            PATHS "${_asciichat_prefix}/lib" NO_DEFAULT_PATH NO_CACHE)
        if(_asciichat_bundled_${_module})
            list(APPEND _asciichat_deps "${_asciichat_bundled_${_module}}")
        else()
            if(_module STREQUAL utf8proc)
                set(_pc_module libutf8proc)
            else()
                set(_pc_module vterm)
            endif()
            pkg_check_modules(_asciichat_${_module} REQUIRED IMPORTED_TARGET "${_pc_module}")
            list(APPEND _asciichat_deps PkgConfig::_asciichat_${_module})
        endif()
    endforeach()
    if(@USE_MIMALLOC@)
        find_library(_asciichat_bundled_mimalloc NAMES mimalloc-static mimalloc
            PATHS "${_asciichat_prefix}/lib" NO_DEFAULT_PATH NO_CACHE)
        if(_asciichat_bundled_mimalloc)
            list(APPEND _asciichat_deps "${_asciichat_bundled_mimalloc}")
        else()
            find_dependency(mimalloc CONFIG)
            if(@ASCIICHAT_SHARED_DEPS@ AND TARGET mimalloc)
                list(APPEND _asciichat_deps mimalloc)
            elseif(TARGET mimalloc-static)
                list(APPEND _asciichat_deps mimalloc-static)
            else()
                list(APPEND _asciichat_deps mimalloc)
            endif()
        endif()
    endif()
    find_dependency(Threads)
    list(APPEND _asciichat_deps Threads::Threads)
    if(APPLE)
        foreach(_framework Foundation AVFoundation CoreMedia CoreVideo CoreAudio AudioUnit
                AudioToolbox CoreServices IOKit)
            list(APPEND _asciichat_deps "-framework ${_framework}")
        endforeach()
        list(APPEND _asciichat_deps m c++)
    elseif(WIN32)
        list(APPEND _asciichat_deps ws2_32 user32 advapi32 dbghelp mf mfplat mfreadwrite mfuuid
            ole32 crypt32 winmm iphlpapi)
    else()
        list(APPEND _asciichat_deps m dl rt stdc++)
    endif()
    add_library(ascii-chat::static STATIC IMPORTED)
    set_target_properties(ascii-chat::static PROPERTIES
        IMPORTED_LOCATION "${_asciichat_archive}"
        INTERFACE_INCLUDE_DIRECTORIES "${_asciichat_include}"
        INTERFACE_LINK_LIBRARIES "${_asciichat_deps}")
endif()

foreach(_variant shared static)
    if(TARGET ascii-chat::${_variant} AND NOT TARGET asciichat::${_variant})
        add_library(asciichat::${_variant} ALIAS ascii-chat::${_variant})
    endif()
endforeach()
if(NOT TARGET asciichat::asciichat)
    if(TARGET ascii-chat::shared)
        add_library(asciichat::asciichat ALIAS ascii-chat::shared)
    elseif(TARGET ascii-chat::static)
        add_library(asciichat::asciichat ALIAS ascii-chat::static)
    endif()
endif()
