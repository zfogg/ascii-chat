{
  "name": "ascii-chat-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --filter './www' --filter './discovery' --filter './web' run dev",
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter '@ascii-chat/shared' run build",
    "build:websites": "pnpm -r --filter './www' --filter './discovery' --filter './web' run build",
    "type-check": "pnpm -r run type-check",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
