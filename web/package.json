{
  "name": "ascii-chat-web",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "openai-sites/*",
      "www",
      "discovery",
      "web"
    ],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
      "vitest": "5.0.5",
      "vite-plus": "1.3.0"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --filter './www' --filter './discovery' --filter './web' run dev",
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter '@ascii-chat/shared' run build",
    "build:websites": "pnpm -r --filter './www' --filter './discovery' --filter './web' run build",
    "type-check": "pnpm -r run type-check",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.33.0"
}
