{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mirror",
      "destination": "/index.html"
    },
    {
      "source": "/client",
      "destination": "/index.html"
    },
    {
      "source": "/discovery",
      "destination": "/index.html"
    }
  ]
}
