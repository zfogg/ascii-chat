# Copy to .env; keep the listener on loopback until the egress checks pass.
# Public IPv4 addresses of this host and any protected public services; space-separated.
MCP_BLOCKED_PUBLIC_IPS=
MCP_IMAGE=ghcr.io/zfogg/ascii-chat:latest
MCP_SITE=http://localhost
MCP_PUBLIC_URL=http://localhost:8080
ACME_EMAIL=you@example.com
ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
MCP_BIND_ADDRESS=127.0.0.1
MCP_HTTP_PORT=8080
MCP_HTTPS_PORT=8443
MCP_CPUS=4.0
MCP_MEMORY=4g
MCP_PIDS=128
MCP_SCRATCH_BYTES=536870912
MCP_DOWNLOAD_BYTES=1073741824
CADDY_CPUS=1.0
CADDY_MEMORY=256m
CADDY_PIDS=64
MCP_RATE_EVENTS=30
MCP_RATE_WINDOW=1m
