cmake_minimum_required(VERSION 3.30)

# Exercise the generated script without application dependencies or a compiler toolchain.
get_filename_component(REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT DEFINED VERSION_TEST_BINARY_DIR)
    set(VERSION_TEST_BINARY_DIR "${CMAKE_CURRENT_BINARY_DIR}/version-test")
endif()
find_program(GIT_EXECUTABLE git REQUIRED)
foreach(variable VERSION PROJECT_VERSION_OVERRIDE SOURCE_COMMIT)
    unset(ENV{${variable}})
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(fixture "${VERSION_TEST_BINARY_DIR}/${run_id}")
file(MAKE_DIRECTORY "${fixture}/include/ascii-chat")
configure_file("${REPO_ROOT}/include/ascii-chat/version.h.in"
    "${fixture}/include/ascii-chat/version.h.in" COPYONLY)
file(WRITE "${fixture}/probe.c" "#include <stdio.h>\n#include <ascii-chat/version.h>\nint main(void) { puts(ASCII_CHAT_VERSION_FULL); return 0; }\n")
file(WRITE "${fixture}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.30)\ninclude(\"${REPO_ROOT}/cmake/install/Version.cmake\")\nset(ASCIICHAT_SOURCE_DIR \"\${CMAKE_CURRENT_SOURCE_DIR}\")\nversion_detect()\nproject(version_probe VERSION \${PROJECT_VERSION_FROM_GIT} LANGUAGES NONE)\nif(VERSION_TEST_NO_GIT)\n  set(GIT_EXECUTABLE \"${CMAKE_COMMAND}/missing-git\")\nendif()\nversion_setup_targets()\n")

function(run)
    execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${fixture}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}\n${error}")
    endif()
endfunction()

function(check_version name expected)
    set(build "${fixture}-build-${name}")
    run("${CMAKE_COMMAND}" -S "${fixture}" -B "${build}" -G Ninja
        -DCMAKE_BUILD_TYPE=Release ${ARGN})
    run("${CMAKE_COMMAND}" --build "${build}" --target generate_version)
    file(READ "${build}/generated/ascii-chat/version.h" header)
    foreach(component VERSION_STRING GIT_VERSION)
        string(REGEX MATCH "#define ASCII_CHAT_${component} \"([^\"]*)\"" match "${header}")
        set(${component} "${CMAKE_MATCH_1}")
    endforeach()
    string(REGEX MATCH "ASCII_CHAT_VERSION_STRING \"([^\"]*)\" ASCII_CHAT_GIT_VERSION" match "${header}")
    set(actual "v${VERSION_STRING}${CMAKE_MATCH_1}${GIT_VERSION}")
    if(NOT actual MATCHES "${expected}")
        message(FATAL_ERROR "${name}: expected ${expected}, got '${actual}'")
    endif()
    message(STATUS "${name}: ${actual}")
endfunction()

run("${GIT_EXECUTABLE}" init)
run("${GIT_EXECUTABLE}" add CMakeLists.txt probe.c include/ascii-chat/version.h.in)
run("${GIT_EXECUTABLE}" -c user.name=VersionTest -c user.email=version@example.invalid -c commit.gpgsign=false commit -m initial)
run("${GIT_EXECUTABLE}" -c tag.gpgsign=false tag v1.2.3)
check_version(tag "^v1[.]2[.]3$")
file(APPEND "${fixture}/probe.c" "\n/* tracked change */\n")
check_version(dirty "^v1[.]2[.]3-dirty$")
run("${GIT_EXECUTABLE}" add probe.c)
run("${GIT_EXECUTABLE}" -c user.name=VersionTest -c user.email=version@example.invalid -c commit.gpgsign=false commit -m development)
check_version(development "^v1[.]2[.]3-dev-1[+]g[0-9a-f]+$")
set(ENV{VERSION} "2.3.4")
check_version(environment "^v2[.]3[.]4$")
unset(ENV{VERSION})
set(ENV{PROJECT_VERSION_OVERRIDE} "3.4.5")
check_version(override "^v3[.]4[.]5$")
unset(ENV{PROJECT_VERSION_OVERRIDE})
set(ENV{VERSION} "2.3.4")
set(ENV{SOURCE_COMMIT} "abcdef123")
check_version(docker "^v2[.]3[.]4-dev-gabcdef123$")
unset(ENV{VERSION})
unset(ENV{SOURCE_COMMIT})
check_version(configured "^v4[.]5[.]6$" -DPROJECT_VERSION_FROM_GIT=4.5.6)
check_version(configured_without_git "^v4[.]5[.]6$" -DPROJECT_VERSION_FROM_GIT=4.5.6 -DVERSION_TEST_NO_GIT=ON)
