cmake_minimum_required(VERSION 3.30)
include(CMakePackageConfigHelpers)
get_filename_component(_repo "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT WORK_DIR)
    message(FATAL_ERROR "Set WORK_DIR to an expendable test output directory")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _id)
get_filename_component(_work "${WORK_DIR}/sdk-config-${_id}" ABSOLUTE)
set(_original "${_work}/original")
set(_relocated "${_work}/relocated")
file(MAKE_DIRECTORY "${_original}/include/ascii-chat" "${_original}/lib/cmake/ascii-chat"
    "${_original}/lib/cmake/asciichat" "${_original}/bin" "${_work}/consumer")
set(ASCIICHAT_LIB_VERSION 0.3.0)
set(PROJECT_VERSION 0.13.5)
set(USE_MIMALLOC OFF)
set(ASCIICHAT_SHARED_DEPS ON)
if(WIN32)
    set(CMAKE_SHARED_LIBRARY_SUFFIX .dll)
    file(TOUCH "${_original}/bin/asciichat.dll" "${_original}/lib/asciichat.lib")
elseif(APPLE)
    set(CMAKE_SHARED_LIBRARY_SUFFIX .dylib)
    file(TOUCH "${_original}/lib/libasciichat.dylib")
else()
    set(CMAKE_SHARED_LIBRARY_SUFFIX .so)
    file(TOUCH "${_original}/lib/libasciichat.so")
endif()
file(TOUCH "${_original}/lib/libasciichat.a")
configure_package_config_file("${_repo}/lib/cmake/libasciichat.cmake.in"
    "${_original}/lib/cmake/ascii-chat/ascii-chat-config.cmake"
    INSTALL_DESTINATION lib/cmake/ascii-chat)
configure_file("${_repo}/lib/cmake/asciichatConfig.cmake.in"
    "${_original}/lib/cmake/asciichat/asciichatConfig.cmake" @ONLY)
write_basic_package_version_file("${_original}/lib/cmake/ascii-chat/ascii-chat-config-version.cmake"
    VERSION 0.3.0 COMPATIBILITY SameMinorVersion)
configure_file("${_original}/lib/cmake/ascii-chat/ascii-chat-config-version.cmake"
    "${_original}/lib/cmake/asciichat/asciichatConfigVersion.cmake" COPYONLY)
file(COPY "${_original}/" DESTINATION "${_relocated}")
file(WRITE "${_work}/consumer/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.30)
project(installed-sdk-config-test LANGUAGES NONE)
set(CMAKE_DISABLE_FIND_PACKAGE_PkgConfig TRUE)
find_package(asciichat 0.3 CONFIG REQUIRED COMPONENTS shared)
find_package(ascii-chat 0.3.0 EXACT CONFIG REQUIRED COMPONENTS shared)
foreach(_property IMPORTED_LOCATION INTERFACE_INCLUDE_DIRECTORIES)
    get_target_property(_paths asciichat::shared ${_property})
    foreach(_path IN LISTS _paths)
        cmake_path(IS_PREFIX SDK_PREFIX "${_path}" NORMALIZE _relocated)
        if(NOT _relocated)
            message(FATAL_ERROR "SDK ${_property} did not relocate: ${_path}")
        endif()
    endforeach()
endforeach()
if(WIN32)
    get_target_property(_implib asciichat::shared IMPORTED_IMPLIB)
    if(NOT EXISTS "${_implib}")
        message(FATAL_ERROR "Windows import library is missing: ${_implib}")
    endif()
endif()
find_package(asciichat 0.4 CONFIG QUIET COMPONENTS shared)
if(asciichat_FOUND)
    message(FATAL_ERROR "An incompatible 0.x SDK ABI was accepted")
endif()
file(REMOVE "${SDK_PREFIX}/lib/libasciichat.a")
find_package(asciichat CONFIG QUIET COMPONENTS static)
if(asciichat_FOUND)
    message(FATAL_ERROR "A missing required static archive was accepted")
endif()
]=])
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_work}/consumer" -B "${_work}/build"
    "-DCMAKE_PREFIX_PATH=${_relocated}" "-DSDK_PREFIX=${_relocated}"
    COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "SDK discovery, relocation, shared-only dependencies and ABI checks passed")
