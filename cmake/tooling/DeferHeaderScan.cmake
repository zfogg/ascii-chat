# Detect defer marker or wrapper identifiers in header code, ignoring comments,
# literals, and preprocessor directives. False positives only enable the
# conservative header-overlay build path.
function(ascii_defer_header_has_code output content_var wrappers_var)
    set(_content "${${content_var}}")
    set(_wrappers "${${wrappers_var}}")
    list(JOIN _wrappers "|" _alternatives)
    if(NOT _content MATCHES "(^|[^A-Za-z0-9_])(${_alternatives})([^A-Za-z0-9_]|$)")
        set(${output} FALSE PARENT_SCOPE)
        return()
    endif()
    string(REPLACE ";" "\\;" _content "${_content}")
    string(REPLACE "\n" ";" _lines "${_content}")
    set(_in_block FALSE)
    foreach(_line IN LISTS _lines)
        if(NOT _in_block AND _line MATCHES "^[ \t]*#")
            continue()
        endif()
        string(LENGTH "${_line}" _length)
        set(_index 0)
        set(_state code)
        set(_escaped FALSE)
        set(_token "")
        while(_index LESS _length)
            string(SUBSTRING "${_line}" ${_index} 1 _char)
            math(EXPR _next "${_index} + 1")
            set(_next_char "")
            if(_next LESS _length)
                string(SUBSTRING "${_line}" ${_next} 1 _next_char)
            endif()
            if(_in_block)
                if(_char STREQUAL "*" AND _next_char STREQUAL "/")
                    set(_in_block FALSE)
                    math(EXPR _index "${_index} + 2")
                    continue()
                endif()
            elseif(NOT _state STREQUAL code)
                if(_escaped)
                    set(_escaped FALSE)
                elseif(_char STREQUAL "\\")
                    set(_escaped TRUE)
                elseif((_state STREQUAL string AND _char STREQUAL "\"") OR
                       (_state STREQUAL character AND _char STREQUAL "'"))
                    set(_state code)
                endif()
            elseif(_char MATCHES "^[A-Za-z0-9_]$")
                string(APPEND _token "${_char}")
            else()
                if(_token IN_LIST _wrappers)
                    set(${output} TRUE PARENT_SCOPE)
                    return()
                endif()
                set(_token "")
                if(_char STREQUAL "/" AND _next_char STREQUAL "/")
                    break()
                elseif(_char STREQUAL "/" AND _next_char STREQUAL "*")
                    set(_in_block TRUE)
                    math(EXPR _index "${_index} + 2")
                    continue()
                elseif(_char STREQUAL "\"")
                    set(_state string)
                elseif(_char STREQUAL "'")
                    set(_state character)
                endif()
            endif()
            math(EXPR _index "${_index} + 1")
        endwhile()
        if(_token IN_LIST _wrappers)
            set(${output} TRUE PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${output} FALSE PARENT_SCOPE)
endfunction()
