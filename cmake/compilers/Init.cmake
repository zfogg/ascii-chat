include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Common.cmake")

if(NOT _ASCIICHAT_COMPILER_MODULE)
    # Configure presets may provide CMAKE_C_COMPILER before project().  Use
    # that native CMake variable as the explicit compiler selection when it is
    # available; compiler IDs are populated only after project().
    get_filename_component(_asciichat_requested_compiler "${CMAKE_C_COMPILER}" NAME)
    string(TOLOWER "${_asciichat_requested_compiler}" _asciichat_requested_compiler)
    if(_asciichat_requested_compiler MATCHES "^(cl|cl.exe)$")
        set(_ASCIICHAT_COMPILER_MODULE MSVC)
    elseif(_asciichat_requested_compiler MATCHES "^(gcc|gcc.exe)$")
        set(_ASCIICHAT_COMPILER_MODULE GCC)
    elseif(_asciichat_requested_compiler MATCHES "^(clang|clang.exe|clang-cl|clang-cl.exe)$")
        set(_ASCIICHAT_COMPILER_MODULE CLANG)
    else()
        find_program(_asciichat_clang clang)
        find_program(_asciichat_gcc gcc)
        if(_asciichat_clang)
            set(CMAKE_C_COMPILER "${_asciichat_clang}" CACHE FILEPATH "C compiler" FORCE)
            find_program(_asciichat_clangxx clang++)
            if(NOT _asciichat_clangxx)
                message(FATAL_ERROR "Clang was found but clang++ is missing")
            endif()
            set(CMAKE_CXX_COMPILER "${_asciichat_clangxx}" CACHE FILEPATH "C++ compiler" FORCE)
            set(_ASCIICHAT_COMPILER_MODULE CLANG)
        elseif(_asciichat_gcc)
            set(CMAKE_C_COMPILER "${_asciichat_gcc}" CACHE FILEPATH "C compiler" FORCE)
            find_program(_asciichat_gxx g++)
            if(NOT _asciichat_gxx)
                message(FATAL_ERROR "GCC was found but g++ is missing")
            endif()
            set(CMAKE_CXX_COMPILER "${_asciichat_gxx}" CACHE FILEPATH "C++ compiler" FORCE)
            set(_ASCIICHAT_COMPILER_MODULE GCC)
        elseif(WIN32)
            set(CMAKE_C_COMPILER cl CACHE FILEPATH "C compiler" FORCE)
            set(CMAKE_CXX_COMPILER cl CACHE FILEPATH "C++ compiler" FORCE)
            set(_ASCIICHAT_COMPILER_MODULE MSVC)
        else()
            message(FATAL_ERROR "No supported compiler found. Install LLVM, GCC, or MSVC.")
        endif()
    endif()
endif()

if(_ASCIICHAT_COMPILER_MODULE STREQUAL "CLANG")
    include("${CMAKE_CURRENT_LIST_DIR}/Clang.cmake")
    function(configure_selected_compiler_pre_project)
        configure_clang_pre_project()
    endfunction()
elseif(_ASCIICHAT_COMPILER_MODULE STREQUAL "GCC")
    include("${CMAKE_CURRENT_LIST_DIR}/Gcc.cmake")
    function(configure_selected_compiler_pre_project)
        configure_gcc_pre_project()
    endfunction()
elseif(_ASCIICHAT_COMPILER_MODULE STREQUAL "MSVC")
    include("${CMAKE_CURRENT_LIST_DIR}/Msvc.cmake")
    function(configure_selected_compiler_pre_project)
        configure_msvc_pre_project()
    endfunction()
else()
    message(FATAL_ERROR "Unable to select a compiler from CMAKE_C_COMPILER='${CMAKE_C_COMPILER}'. Expected Clang, GCC, or MSVC.")
endif()
