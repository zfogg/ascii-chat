# Validation for fully static musl targets.
include_guard(GLOBAL)

function(asciichat_validate_musl_target target)
    if(NOT USE_MUSL OR NOT TARGET "${target}")
        return()
    endif()
    set(_queue "${target}")
    set(_seen)
    while(_queue)
        list(POP_FRONT _queue _current)
        if("${_current}" IN_LIST _seen OR NOT TARGET "${_current}")
            continue()
        endif()
        list(APPEND _seen "${_current}")
        get_target_property(_link_options "${_current}" INTERFACE_LINK_OPTIONS)
        get_target_property(_link_libs "${_current}" INTERFACE_LINK_LIBRARIES)
        get_target_property(_private_libs "${_current}" LINK_LIBRARIES)
        foreach(_value IN LISTS _link_options _link_libs _private_libs)
            if("${_value}" MATCHES "(^|/)usr/include|libgcc|gcc_s|glibc|\.so($|[.;])")
                message(FATAL_ERROR "Musl target ${target} contains forbidden host dependency through ${_current}: ${_value}")
            endif()
            if(TARGET "${_value}")
                list(APPEND _queue "${_value}")
            endif()
        endforeach()
    endwhile()
endfunction()

function(asciichat_validate_project_musl)
    if(USE_MUSL)
        foreach(_target IN ITEMS ascii-chat ascii-chat-static ascii-chat-shared asciichat-core-dependencies)
            asciichat_validate_musl_target("${_target}")
        endforeach()
    endif()
endfunction()
