# Validation for fully static musl targets.
include_guard(GLOBAL)

function(asciichat_validate_musl_target target)
    if(NOT USE_MUSL OR NOT TARGET "${target}")
        return()
    endif()
    set(_queue "${target}")
    set(_seen)
    set(_scanned_files)
    find_program(_asciichat_musl_nm NAMES llvm-nm nm)
    while(_queue)
        list(POP_FRONT _queue _current)
        if("${_current}" IN_LIST _seen OR NOT TARGET "${_current}")
            continue()
        endif()
        list(APPEND _seen "${_current}")
        get_target_property(_link_options "${_current}" INTERFACE_LINK_OPTIONS)
        get_target_property(_link_libs "${_current}" INTERFACE_LINK_LIBRARIES)
        get_target_property(_include_dirs "${_current}" INTERFACE_INCLUDE_DIRECTORIES)
        get_target_property(_private_libs "${_current}" LINK_LIBRARIES)
        get_target_property(_imported_location "${_current}" IMPORTED_LOCATION)
        get_target_property(_imported_location_release "${_current}" IMPORTED_LOCATION_RELEASE)
        get_target_property(_imported_implib "${_current}" IMPORTED_IMPLIB)
        foreach(_value IN LISTS _link_options _link_libs _include_dirs _private_libs
            _imported_location _imported_location_release _imported_implib)
            set(_is_host_include FALSE)
            if("${_value}" MATCHES "(^|/)usr/include")
                if("${_value}" MATCHES "/alpine-libcxx/" OR
                    "${_value}" MATCHES "/usr/include/[^;>]*musl(/|$)" OR
                    (MUSL_TARGET AND "${_value}" MATCHES "/usr/include/${MUSL_TARGET}(/|$)"))
                    set(_is_host_include FALSE)
                else()
                    set(_is_host_include TRUE)
                endif()
            endif()
            if(_is_host_include OR "${_value}" MATCHES "libgcc|gcc_s|glibc|\.so($|[.;])")
                message(FATAL_ERROR "Musl target ${target} contains forbidden host dependency through ${_current}: ${_value}")
            endif()
            if(_asciichat_musl_nm AND EXISTS "${_value}" AND
                "${_value}" MATCHES "\\.(a|o)$" AND NOT "${_value}" IN_LIST _scanned_files)
                list(APPEND _scanned_files "${_value}")
                execute_process(
                    COMMAND "${_asciichat_musl_nm}" -u "${_value}"
                    OUTPUT_VARIABLE _undefined_symbols
                    ERROR_QUIET)
                if(_undefined_symbols MATCHES "GLIBC_|__libc_|__pthread_unwind|fcntl64")
                    message(FATAL_ERROR
                        "Musl target ${target} contains glibc-only symbols in ${_value}:\n${_undefined_symbols}")
                endif()
            endif()
            if(TARGET "${_value}")
                list(APPEND _queue "${_value}")
            endif()
        endforeach()
    endwhile()
endfunction()

function(asciichat_validate_project_musl)
    if(USE_MUSL)
        foreach(_target IN ITEMS ascii-chat ascii-chat-static ascii-chat-shared asciichat-core-dependencies)
            asciichat_validate_musl_target("${_target}")
        endforeach()
    endif()
endfunction()
