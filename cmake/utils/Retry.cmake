include_guard(GLOBAL)

function(asciichat_download_with_retry url destination expected_sha256)
    if(EXISTS "${destination}")
        file(SHA256 "${destination}" cached_sha256)
        if(cached_sha256 STREQUAL expected_sha256)
            return()
        endif()
        message(STATUS "  Discarding invalid cached downloaded archive")
        file(REMOVE "${destination}")
    endif()

    set(temporary "${destination}.download")
    foreach(attempt RANGE 1 4)
        file(REMOVE "${temporary}")
        file(DOWNLOAD "${url}" "${temporary}" STATUS download_status SHOW_PROGRESS
             TIMEOUT 180 INACTIVITY_TIMEOUT 30)
        list(GET download_status 0 status_code)
        list(GET download_status 1 status_message)
        if(status_code EQUAL 0)
            file(SHA256 "${temporary}" actual_sha256)
            if(actual_sha256 STREQUAL expected_sha256)
                file(RENAME "${temporary}" "${destination}")
                return()
            endif()
            set(status_message "SHA256 mismatch (expected ${expected_sha256}, got ${actual_sha256})")
        endif()
        file(REMOVE "${temporary}")
        if(attempt LESS 4)
            math(EXPR delay "1 << (${attempt} - 1)")
            message(STATUS "  Download attempt ${attempt} failed: ${status_message}; retrying in ${delay}s")
            execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep "${delay}")
        endif()
    endforeach()
    message(FATAL_ERROR "Failed to download ${url} after 4 attempts: ${status_message}")
endfunction()
