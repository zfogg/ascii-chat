include_guard(GLOBAL)
include(FetchContent)
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/../find")

# Call inside a function so upstream options do not change sibling projects.
macro(asciichat_dependency_defaults)
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    set(CMAKE_POLICY_DEFAULT_CMP0126 NEW)
    set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
    set(BUILD_SHARED_LIBS "${ASCIICHAT_SHARED_DEPS}")
    if(EMSCRIPTEN OR PLATFORM_IOS OR USE_MUSL)
        set(BUILD_SHARED_LIBS OFF)
    endif()
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
    set(CMAKE_C_STANDARD 11)
    set(CMAKE_C_STANDARD_REQUIRED ON)
    set(CMAKE_C_EXTENSIONS ON)
    set(CMAKE_CXX_EXTENSIONS ON)
    set(CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS ON)
    set(BUILD_TESTING OFF)
    set(BUILD_TESTS OFF)
    if(USE_MUSL)
        if(NOT MUSL_TARGET)
            if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64|ARM64")
                set(MUSL_TARGET aarch64-linux-musl)
            else()
                set(MUSL_TARGET x86_64-linux-musl)
            endif()
        endif()
        # Configure probes and compilation must both use the target's libc headers.
        set(_dependency_c_flags "-target ${MUSL_TARGET} -nostdlibinc -isystem ${MUSL_INCLUDE_DIR} -isystem ${KERNEL_HEADERS_DIR}")
        string(APPEND CMAKE_C_FLAGS " ${_dependency_c_flags}")
        string(APPEND CMAKE_CXX_FLAGS " -target ${MUSL_TARGET} -stdlib=libc++ -nostdinc++ -isystem ${ALPINE_LIBCXX_INCLUDE_DIR} -nostdlibinc -isystem ${MUSL_INCLUDE_DIR} -isystem ${KERNEL_HEADERS_DIR}")
        if(MUSL_TARGET MATCHES "^aarch64")
            string(APPEND CMAKE_C_FLAGS " -mno-outline-atomics")
            string(APPEND CMAKE_CXX_FLAGS " -mno-outline-atomics")
        endif()
        set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
    endif()
endmacro()
