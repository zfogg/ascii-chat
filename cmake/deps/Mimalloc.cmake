# Use the installed package or upstream targets, including its allocator feature options.
if(PLATFORM_IOS)
    if(TARGET asciichat-project-options)
        target_compile_definitions(asciichat-project-options INTERFACE USE_MIMALLOC=0)
    endif()
    return()
endif()
if(NOT USE_MIMALLOC)
    return()
endif()

if(NOT USE_MUSL AND NOT ASCIICHAT_BUILD_DEPS_FROM_SOURCE AND (WIN32 OR BUILD_SHARED_LIBS))
    find_package(mimalloc QUIET CONFIG)
endif()
if(NOT TARGET mimalloc AND NOT TARGET mimalloc-static)
    include(${CMAKE_CURRENT_LIST_DIR}/../utils/SourceDependency.cmake)
    function(asciichat_build_mimalloc)
        asciichat_dependency_defaults()
        set(MI_BUILD_SHARED ${BUILD_SHARED_LIBS})
        set(MI_BUILD_STATIC ON)
        set(MI_BUILD_OBJECT OFF)
        set(MI_BUILD_TESTS OFF)
        set(MI_OVERRIDE OFF)
        set(MI_WIN_REDIRECT OFF)
        set(MI_INSTALL_TOPLEVEL OFF)
        if(CMAKE_BUILD_TYPE STREQUAL "Debug")
            set(MI_TRACK_ASAN ON)
        endif()
        if(USE_MUSL)
            set(MI_LOCAL_DYNAMIC_TLS ON)
            set(CMAKE_INTERPROCEDURAL_OPTIMIZATION OFF)
        endif()
        asciichat_fetchcontent_declare(asciichat_mimalloc
            GIT_REPOSITORY https://github.com/microsoft/mimalloc.git
            GIT_TAG v2.2.4 GIT_SHALLOW TRUE
            BINARY_DIR "${ASCIICHAT_DEPS_CACHE_DIR}/build/mimalloc"
            EXCLUDE_FROM_ALL)
        FetchContent_MakeAvailable(asciichat_mimalloc)
        foreach(_target mimalloc-static mimalloc)
            if(TARGET ${_target})
                target_compile_options(${_target} PRIVATE -include errno.h)
                if(UNIX)
                    target_compile_options(${_target} PRIVATE -fPIC -ftls-model=global-dynamic)
                endif()
            endif()
        endforeach()
        set(MIMALLOC_SOURCE_DIR "${asciichat_mimalloc_SOURCE_DIR}" PARENT_SCOPE)
    endfunction()
    asciichat_build_mimalloc()
endif()

if(BUILD_SHARED_LIBS AND TARGET mimalloc)
    set(_mimalloc_target mimalloc)
elseif(TARGET mimalloc-static)
    set(_mimalloc_target mimalloc-static)
elseif(TARGET mimalloc)
    set(_mimalloc_target mimalloc)
else()
    message(FATAL_ERROR "mimalloc did not provide a usable CMake target")
endif()
get_target_property(_mimalloc_actual ${_mimalloc_target} ALIASED_TARGET)
if(NOT _mimalloc_actual)
    set(_mimalloc_actual ${_mimalloc_target})
endif()
get_target_property(_mimalloc_type ${_mimalloc_target} TYPE)
if(_mimalloc_type STREQUAL "SHARED_LIBRARY")
    set(MIMALLOC_IS_SHARED_LIB TRUE)
    if(TARGET asciichat-project-options)
        target_compile_definitions(asciichat-project-options INTERFACE USE_MIMALLOC)
    endif()
else()
    set(MIMALLOC_IS_SHARED_LIB FALSE)
    if(TARGET asciichat-project-options)
        target_compile_definitions(asciichat-project-options INTERFACE USE_MIMALLOC MI_STATIC_LIB)
    endif()
endif()
get_target_property(_mimalloc_include_dirs ${_mimalloc_target} INTERFACE_INCLUDE_DIRECTORIES)

if(NOT TARGET asciichat-mimalloc)
    add_library(asciichat-mimalloc INTERFACE)
    target_link_libraries(asciichat-mimalloc INTERFACE ${_mimalloc_target})
    if(_mimalloc_include_dirs)
        target_include_directories(asciichat-mimalloc INTERFACE ${_mimalloc_include_dirs})
    endif()
endif()
if(NOT _mimalloc_include_dirs)
    find_path(_mimalloc_include_dirs NAMES mimalloc.h
        HINTS "${MIMALLOC_SOURCE_DIR}/include"
        REQUIRED)
endif()

# A source-built mimalloc target must compile against its own headers.  On
# macOS, Homebrew can add a newer mimalloc include directory globally; allowing
# that header to win over the cached source headers produces mixed-version
# errors inside mimalloc itself.
if(MIMALLOC_SOURCE_DIR AND EXISTS "${MIMALLOC_SOURCE_DIR}/include/mimalloc.h")
    set(_mimalloc_include_dirs "${MIMALLOC_SOURCE_DIR}/include")
    target_include_directories(${_mimalloc_target} BEFORE PRIVATE
        "${MIMALLOC_SOURCE_DIR}/include")
endif()
if(_mimalloc_include_dirs)
    target_include_directories(asciichat-mimalloc INTERFACE ${_mimalloc_include_dirs})
endif()
