# Prefer package targets; source builds use the same upstream target graph.
set(ASCIICHAT_WEBRTC_RUNTIME_DLLS "" CACHE INTERNAL "WebRTC sanitizer runtime" FORCE)
if(NOT (USE_MUSL OR PLATFORM_IOS OR ASCIICHAT_BUILD_DEPS_FROM_SOURCE))
    find_package(LibDataChannel QUIET CONFIG)
    if(TARGET LibDataChannel::LibDataChannel)
        # ASan uses the release CRT; do not load the debug C++ CRT via WebRTC.
        if(WIN32 AND ASCIICHAT_ASAN_DYNAMIC_IMPORT_LIB)
            set(_webrtc_runtime_dlls "")
            foreach(_target LibDataChannel::LibDataChannel LibJuice::LibJuice)
                if(TARGET ${_target})
                    get_target_property(_runtime ${_target} IMPORTED_LOCATION_RELEASE)
                    if(_runtime AND EXISTS "${_runtime}")
                        set_property(TARGET ${_target} PROPERTY MAP_IMPORTED_CONFIG_DEBUG Release)
                        list(APPEND _webrtc_runtime_dlls "${_runtime}")
                    endif()
                endif()
            endforeach()
            set(ASCIICHAT_WEBRTC_RUNTIME_DLLS "${_webrtc_runtime_dlls}" CACHE INTERNAL "WebRTC sanitizer runtime" FORCE)
        endif()
        if(NOT TARGET asciichat-libdatachannel)
            add_library(asciichat-libdatachannel INTERFACE)
            target_link_libraries(asciichat-libdatachannel INTERFACE LibDataChannel::LibDataChannel)
        endif()
        set(_libdatachannel_available TRUE)
        return()
    endif()
    find_package(PkgConfig QUIET)
    if(PkgConfig_FOUND)
        pkg_check_modules(LIBDATACHANNEL_PC QUIET IMPORTED_TARGET libdatachannel)
        if(TARGET PkgConfig::LIBDATACHANNEL_PC)
            if(NOT TARGET asciichat-libdatachannel)
                add_library(asciichat-libdatachannel INTERFACE)
                target_link_libraries(asciichat-libdatachannel INTERFACE PkgConfig::LIBDATACHANNEL_PC)
            endif()
            set(_libdatachannel_available TRUE)
            return()
        endif()
    endif()
endif()

include(${CMAKE_CURRENT_LIST_DIR}/../utils/SourceDependency.cmake)
function(asciichat_build_libdatachannel)
    asciichat_dependency_defaults()
    set(BUILD_SHARED_DEPS_LIBS ${BUILD_SHARED_LIBS})
    set(NO_TESTS ON)
    set(NO_EXAMPLES ON)
    set(NO_MEDIA ON)
    set(NO_WEBSOCKET ON)
    set(USE_GNUTLS OFF)
    set(USE_MBEDTLS OFF)
    set(PREFER_SYSTEM_LIB OFF)
    set(WARNINGS_AS_ERRORS OFF)
    set(sctp_werror OFF)
    set(_asciichat_libdatachannel_source
        "${ASCIICHAT_DEPS_CACHE_DIR}/asciichat_libdatachannel-src")
    if(EXISTS "${_asciichat_libdatachannel_source}/CMakeLists.txt")
        asciichat_fetchcontent_declare(asciichat_libdatachannel
            SOURCE_DIR "${_asciichat_libdatachannel_source}"
            BINARY_DIR "${ASCIICHAT_DEPS_CACHE_DIR}/libdatachannel-build")
    else()
        asciichat_fetchcontent_declare(asciichat_libdatachannel
            BINARY_DIR "${ASCIICHAT_DEPS_CACHE_DIR}/libdatachannel-build"
            GIT_REPOSITORY https://github.com/paullouisageneau/libdatachannel.git
            GIT_TAG v0.22.5 GIT_SHALLOW TRUE
            GIT_SUBMODULES deps/plog deps/libjuice deps/usrsctp GIT_SUBMODULES_RECURSE TRUE
            SOURCE_DIR "${_asciichat_libdatachannel_source}")
    endif()
    FetchContent_GetProperties(asciichat_libdatachannel)
    if(NOT asciichat_libdatachannel_POPULATED)
        cmake_policy(PUSH)
        if(POLICY CMP0169)
            cmake_policy(SET CMP0169 OLD)
        endif()
        FetchContent_Populate(asciichat_libdatachannel)
        cmake_policy(POP)
    endif()
    set(LIBDATACHANNEL_SOURCE_DIR "${asciichat_libdatachannel_SOURCE_DIR}")
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/patches/patch-libdatachannel-cmake.cmake")
    add_subdirectory("${asciichat_libdatachannel_SOURCE_DIR}" "${asciichat_libdatachannel_BINARY_DIR}" EXCLUDE_FROM_ALL)
    if(WIN32)
        target_compile_definitions(datachannel PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    endif()
endfunction()
asciichat_build_libdatachannel()
if(NOT TARGET asciichat-libdatachannel)
    add_library(asciichat-libdatachannel INTERFACE)
    target_link_libraries(asciichat-libdatachannel INTERFACE datachannel)
    target_include_directories(asciichat-libdatachannel INTERFACE
        "${asciichat_libdatachannel_SOURCE_DIR}/include")
endif()
set(_libdatachannel_available TRUE)
