# Prefer package targets; source builds use the same upstream target graph.
if(NOT (USE_MUSL OR PLATFORM_IOS OR ASCIICHAT_BUILD_DEPS_FROM_SOURCE))
    find_package(LibDataChannel QUIET CONFIG)
    if(TARGET LibDataChannel::LibDataChannel)
        add_library(libdatachannel INTERFACE)
        target_link_libraries(libdatachannel INTERFACE LibDataChannel::LibDataChannel)
        set(LIBDATACHANNEL_FOUND TRUE)
        return()
    endif()
    find_package(PkgConfig QUIET)
    if(PkgConfig_FOUND)
        pkg_check_modules(LIBDATACHANNEL_PC QUIET IMPORTED_TARGET libdatachannel)
        if(TARGET PkgConfig::LIBDATACHANNEL_PC)
            add_library(libdatachannel INTERFACE)
            target_link_libraries(libdatachannel INTERFACE PkgConfig::LIBDATACHANNEL_PC)
            set(LIBDATACHANNEL_FOUND TRUE)
            return()
        endif()
    endif()
endif()

include(${CMAKE_CURRENT_LIST_DIR}/../utils/SourceDependency.cmake)
function(asciichat_build_libdatachannel)
    asciichat_dependency_defaults()
    set(BUILD_SHARED_DEPS_LIBS ${BUILD_SHARED_LIBS})
    set(NO_TESTS ON)
    set(NO_EXAMPLES ON)
    set(NO_MEDIA ON)
    set(NO_WEBSOCKET ON)
    set(USE_GNUTLS OFF)
    set(USE_MBEDTLS OFF)
    set(PREFER_SYSTEM_LIB OFF)
    set(WARNINGS_AS_ERRORS OFF)
    set(sctp_werror OFF)
    FetchContent_Declare(asciichat_libdatachannel
            BINARY_DIR "${CMAKE_BINARY_DIR}/_deps/asciichat_libdatachannel"
        GIT_REPOSITORY https://github.com/paullouisageneau/libdatachannel.git
        GIT_TAG v0.22.5 GIT_SHALLOW TRUE
        GIT_SUBMODULES deps/plog deps/libjuice deps/usrsctp GIT_SUBMODULES_RECURSE TRUE
        SOURCE_SUBDIR asciichat-patch-first)
    FetchContent_MakeAvailable(asciichat_libdatachannel)
    set(LIBDATACHANNEL_SOURCE_DIR "${asciichat_libdatachannel_SOURCE_DIR}")
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/patches/patch-libdatachannel-cmake.cmake")
    add_subdirectory("${asciichat_libdatachannel_SOURCE_DIR}" "${asciichat_libdatachannel_BINARY_DIR}" EXCLUDE_FROM_ALL)
    if(WIN32)
        target_compile_definitions(datachannel PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    endif()
endfunction()
asciichat_build_libdatachannel()
add_library(libdatachannel INTERFACE)
target_link_libraries(libdatachannel INTERFACE datachannel)
set(LIBDATACHANNEL_FOUND TRUE)
