[Unit]
Description=ascii-chat API server
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=@ASCII_CHAT_EXECUTABLE@ server 0.0.0.0 ::
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectHome=read-only
PrivateTmp=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=null
StandardError=null
SyslogIdentifier=ascii-chat-api-server
WatchdogSec=30s
CPUQuota=200%
MemoryMax=1G

[Install]
WantedBy=multi-user.target
