[Unit]
Description=ascii-chat API server
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/ascii-chat server 0.0.0.0 ::
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectHome=read-only
PrivateTmp=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ascii-chat-api-server
WatchdogSec=30s

[Install]
WantedBy=multi-user.target
