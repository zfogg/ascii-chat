 * @struct acds_protocol_t
 * @brief When code needs to work with acds protocol, it keeps the associated state here instead of scattering it across globals. Initialization establishes the handles and sizes; teardown must release any allocation, lock, thread, or callback context recorded in those fields.
 */
/**
 * @struct acds_server_t
 * @brief acds server is intentionally a small, concrete record. Fields such as `network_server`, `handoff_mutex`, `handoffs`, `db` give callers the identity and current value they need. It is normally borrowed from, or owned by, the surrounding subsystem—not independently managed.
 */
/**
 * @struct acds_session_create_params_t
 * @brief Session creation request parameters
 */
/**
 * @struct acds_session_create_result_t
 * @brief Session creation result
 */
/**
 * @struct acds_session_join_params_t
 * @brief Session join parameters
 */
/**
 * @struct acds_session_join_result_t
 * @brief Session join result
 */
